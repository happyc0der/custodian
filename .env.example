# ---- Server ----
PORT=3001
# Public HTTPS origin of this server (used as the OAuth `resource` and JWT audience).
# For local dev with cloudflared, set this to the tunnel URL.
PUBLIC_URL=http://localhost:3001

# ---- Storage ----
# file | dynamo
STORE=file
FILE_STORE_PATH=./data/store.json
DYNAMO_TABLE=custodian
AWS_REGION=us-west-2

# ---- Auth ----
# dev  -> accepts DEV_BEARER_TOKEN as a bearer for local tools (Local Inspector, Claude Desktop, basic-host)
# oauth-> full OAuth 2.1 (what Alexa+ requires)
AUTH_MODE=dev
DEV_BEARER_TOKEN=dev-token
# Pre-registered OAuth client for Alexa+ (also entered via `alexa-ai configure-account-linking`)
OAUTH_CLIENT_ID=alexa
OAUTH_CLIENT_SECRET=change-me
# Comma-separated allowlist of redirect URIs Alexa+ will use (all region-specific URIs from the console)
OAUTH_REDIRECT_URIS=https://alexa.amazon.com/api/skill/link/XXXXXXXXXXXXX
# PEM-encoded ES256 private key for signing tokens; generated on first boot if empty (dev only)
JWT_PRIVATE_KEY=

# ---- Recall sweep ----
SWEEP_CRON=0 * * * *
SWEEP_ON_BOOT=true

# ---- Bedrock (optional, off the hot path) ----
BEDROCK_ENABLED=false
BEDROCK_REGION=us-west-2
BEDROCK_MODEL=anthropic.claude-opus-5
