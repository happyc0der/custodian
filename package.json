{
  "name": "custodian",
  "private": true,
  "version": "0.1.0",
  "description": "Custodian — a household inventory and product-safety agent for Alexa+, delivered as a self-hosted MCP server.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @custodian/server",
    "start": "npm run start -w @custodian/server",
    "smoke": "tsx scripts/smoke.ts",
    "oauth:conformance": "tsx scripts/oauth-conformance.ts",
    "gen:assets": "tsx scripts/gen-assets.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
